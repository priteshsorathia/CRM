generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int            @id @default(autoincrement())
  email                 String         @unique
  name                  String
  phone                 String?
  password              String
  role                  String         @default("shop_owner")
  upiId                 String?
  shopId                Int?
  employeeId            Int?           @unique
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  username              String         @unique
  enable_combo_module   Boolean        @default(true)
  enable_expense_module Boolean        @default(true)
  userType              String?        @default("retailers") // "retailers" or "restaurants"
  isBlocked             Boolean        @default(false)
  activities            ActivityLog[]
  serviceNotificationStates ServiceNotificationState[]
  draftInvoices         DraftInvoice[]
  expenses              Expense[]
  reviewedExpenses      Expense[]      @relation("ExpenseReviewedBy")
  invoices              Invoice[]
  employee              Employee?      @relation("UserEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  shop                  Shop?          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  reviewedLeaveRequests LeaveRequest[] @relation("LeaveReviewedBy")
  serviceJournalEntries ServiceJournalEntry[]

  @@map("users")
}

model Shop {
  id                          Int                         @id @default(autoincrement())
  name                        String
  ownerName                   String?
  address                     String
  phone                       String
  email                       String
  gstNumber                   String?
  upiId                       String?
  logo                        String?
  userType                    String?                     @default("retailers") // "retailers" or "restaurants"
  isBlocked                   Boolean                     @default(false)
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  categories                  Category[]
  activityLogs                ActivityLog[]
  serviceNotificationStates   ServiceNotificationState[]
  attendances                 Attendance[]
  comboProducts               ComboProduct[]
  draftInvoiceItems           DraftInvoiceItem[]
  draftInvoices               DraftInvoice[]
  employees                   Employee[]
  expenses                    Expense[]
  items                       InventoryItem[]
  invoiceItems                InvoiceItem[]
  invoices                    Invoice[]
  payrolls                    Payroll[]
  purchaseBills               PurchaseBill[]
  shopSettings                ShopSettings?
  stockEntries                StockEntry[]
  users                       User[]
  punches                     Punch[]
  leaveRequests               LeaveRequest[]
  restaurantTables            RestaurantTable[]
  restaurantMenuCategories    RestaurantMenuCategory[]
  restaurantMenuSubCategories RestaurantMenuSubCategory[]
  restaurantMenuAddOns        RestaurantMenuAddOn[]
  restaurantMenuItems         RestaurantMenuItem[]
  restaurantOrders            RestaurantOrder[]
  restaurantInvoices          RestaurantInvoice[]
  serviceProjects             ServiceProject[]
  serviceTasks                ServiceTask[]
  serviceTimesheets           ServiceTimesheet[]
  ServiceClient               ServiceClient[]
  assets                      Asset[]
  serviceInvoices             ServiceInvoice[]
  serviceJournalEntries       ServiceJournalEntry[]
  serviceAccountingSheets     ServiceAccountingSheet[]
  serviceFiscalPeriods        ServiceFiscalPeriod[]
  rolePermissions             RolePermission[]
  departments                 Department[]

  @@map("shops")
}

model UnitCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  units       Unit[]

  @@map("unit_categories")
}

model Unit {
  id                Int                @id @default(autoincrement())
  name              String             @unique
  symbol            String             @unique
  conversionRate    Float              @default(1.0)
  isBaseUnit        Boolean            @default(false)
  unitCategoryId    Int
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  draftInvoiceItems DraftInvoiceItem[]
  inventoryItems    InventoryItem[]
  invoiceItems      InvoiceItem[]
  stockEntries      StockEntry[]
  unitCategory      UnitCategory       @relation(fields: [unitCategoryId], references: [id], onDelete: Cascade)

  @@map("units")
}

model InventoryItem {
  id                Int                @id @default(autoincrement())
  item_name         String
  item_code         String
  barcode           String?            @unique
  category          String?
  brand             String?
  default_quantity  Float              @default(1)
  item_image        String?
  default_unit_id   Int
  shopId            Int
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  original_price    Float
  selling_price     Float
  comboItems        ComboItem[]
  draftInvoiceItems DraftInvoiceItem[]
  unit              Unit               @relation(fields: [default_unit_id], references: [id])
  shop              Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  invoiceItems      InvoiceItem[]
  stockEntries      StockEntry[]

  @@unique([shopId, item_code])
  @@map("inventory_items")
}

model ComboProduct {
  id          Int         @id @default(autoincrement())
  name        String
  code        String
  description String?
  barcode     String?     @unique
  shopId      Int
  price       Float
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  image       String?
  items         ComboItem[]
  invoice_items InvoiceItem[]
  shop          Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, code])
  @@map("combo_products")
}

model ComboItem {
  id              Int           @id @default(autoincrement())
  comboId         Int
  inventoryItemId Int
  quantity        Float         @default(1)
  combo           ComboProduct  @relation(fields: [comboId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@map("combo_items")
}

model StockEntry {
  id           Int           @id @default(autoincrement())
  itemId       Int
  quantity     Float
  unitId       Int
  stockType    String
  pricePerUnit Float?
  totalValue   Float?
  notes        String?
  shopId       Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  unit         Unit          @relation(fields: [unitId], references: [id])

  @@map("stock_entries")
}

model Invoice {
  id                  Int              @id @default(autoincrement())
  invoice_number      String
  invoice_date        DateTime
  customer_name       String
  customer_phone      String?
  customer_address    String?
  customer_gst        String?
  subtotal            Float
  tax_percentage      Float
  tax_amount          Float
  discount            Float            @default(0)
  discount_type       String           @default("percentage")
  discount_amount     Float            @default(0)
  total               Float
  rounded_total       Float
  round_off           Float            @default(0)
  payment_method      String           @default("Cash")
  payment_status      String           @default("Paid")
  amount_paid         Float            @default(0)
  balance_due         Float            @default(0)
  notes               String?
  shopId              Int
  userId              Int?
  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt
  interest_percentage Float            @default(0)
  interest_amount     Float            @default(0)
  emi_months          Int?             @default(0)
  exchange            Boolean          @default(false)
  buyback             Boolean          @default(false)
  making_charges      Float            @default(0)
  invoice_items       InvoiceItem[]
  payments            InvoicePayment[]
  shop                Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user                User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model InvoicePayment {
  id             Int      @id @default(autoincrement())
  invoiceId      Int
  amount         Float
  payment_date   DateTime @default(now())
  payment_method String?
  note           String?
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_payments")
}

model InvoiceItem {
  id             Int            @id @default(autoincrement())
  invoice_id     Int
  item_id        Int?
  combo_id       Int?
  item_name      String
  unit_id        Int
  unit_name      String
  unit_symbol    String
  quantity       Float
  price_per_unit Float
  item_total     Float
  shopId         Int
  invoice        Invoice        @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  inventory_item InventoryItem? @relation(fields: [item_id], references: [id])
  combo_product  ComboProduct?  @relation(fields: [combo_id], references: [id])
  shop           Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  unit           Unit           @relation(fields: [unit_id], references: [id])

  @@map("invoice_items")
}

model ShopSettings {
  id                      Int      @id @default(autoincrement())
  shopId                  Int      @unique
  default_tax             Float    @default(5.0)
  invoice_prefix          String   @default("INV")
  invoice_counter         Int      @default(1)
  order_prefix            String   @default("ORD-")
  order_counter           Int      @default(1)
  project_prefix          String   @default("PRJ-")
  project_counter         Int      @default(1)
  client_prefix           String   @default("CLT-")
  client_counter          Int      @default(1)
  service_invoice_prefix  String   @default("INV-")
  service_invoice_counter Int      @default(1)
  invoice_notes           String?
  stock_deduction         Boolean
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt
  hide_non_taxable        Boolean  @default(false)
  enable_buyback_exchange Boolean  @default(false)
  enable_barcode_scanner  Boolean  @default(false)
  price_column_label      String   @default("Price per unit")
  shop                    Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("shop_settings")
}

model Employee {
  id            Int            @id @default(autoincrement())
  emp_id        String
  full_name     String
  email         String?
  username      String?
  password      String?
  phone         String?
  role          String?
  salary        Float          @default(0)
  join_date     DateTime
  dob           DateTime?
  gender        String?
  bloodGroup    String?
  address       String?
  department    String?
  reportingManager String?
  employmentType String?
  workLocation   String?
  probationDays  Int?
  status        String         @default("active")
  shopId        Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  attendances   Attendance[]
  payrolls      Payroll[]
  shop          Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  punches       Punch[]
  leaveRequests LeaveRequest[]
  isDeleted     Boolean        @default(false)
  user          User?          @relation("UserEmployee")

  @@unique([shopId, emp_id])
  @@map("employees")
}

model LeaveRequest {
  id           Int       @id @default(autoincrement())
  type         String
  from_date    DateTime  @db.Date
  to_date      DateTime  @db.Date
  days         Int
  reason       String?
  status       String    @default("pending") // pending | approved | rejected
  decisionNote String?
  reviewedAt   DateTime?

  employeeId   Int
  shopId       Int
  reviewedById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  reviewedBy User?    @relation("LeaveReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([shopId, status])
  @@index([employeeId, status])
  @@map("leave_requests")
}

model Attendance {
  id         Int       @id @default(autoincrement())
  date       DateTime  @db.Date
  check_in   DateTime?
  check_out  DateTime?
  status     String    @default("absent")
  note       String?
  employeeId Int
  shopId     Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shop       Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@map("attendances")
}

model Punch {
  id         Int       @id @default(autoincrement())
  date       DateTime? @db.Date
  check_in   DateTime?
  check_out  DateTime?
  employeeId Int
  shopId     Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime? @updatedAt
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shop       Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([employeeId, shopId])
  @@map("punches")
}

model Payroll {
  id             Int       @id @default(autoincrement())
  month          DateTime
  working_days   Int
  present_days   Int
  basic_salary   Float
  allowances     Float     @default(0)
  deductions     Float     @default(0)
  net_salary     Float
  status         String    @default("pending")
  payment_date   DateTime?
  payment_method String?
  notes          String?
  employeeId     Int
  shopId         Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shop           Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month])
  @@map("payrolls")
}

model RestaurantTable {
  id           Int      @id @default(autoincrement())
  table_number String
  capacity     Int
  status       String   @default("available")
  section      String?
  notes        String?
  qr_token     String?  @unique
  shopId       Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, table_number])
  @@map("restaurant_tables")
}

model RestaurantMenuCategory {
  id            Int                         @id @default(autoincrement())
  name          String
  food_type     String?
  shopId        Int
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  shop          Shop                        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  subCategories RestaurantMenuSubCategory[]
  items         RestaurantMenuItem[]

  @@unique([shopId, name])
  @@map("restaurant_menu_categories")
}

model RestaurantMenuSubCategory {
  id         Int                     @id @default(autoincrement())
  name       String
  categoryId Int?
  shopId     Int
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  shop       Shop                    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category   RestaurantMenuCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items      RestaurantMenuItem[]

  @@unique([shopId, name])
  @@map("restaurant_menu_sub_categories")
}

model RestaurantMenuAddOn {
  id        Int      @id @default(autoincrement())
  name      String
  price     Float    @default(0)
  shopId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, name])
  @@map("restaurant_menu_add_ons")
}

model RestaurantMenuItem {
  id             Int                        @id @default(autoincrement())
  name           String
  description    String?
  price          Float
  original_price Float?
  food_type      String?
  categoryId     Int?
  subCategoryId  Int?
  service_types  String[]
  add_on_ids     Int[]
  is_available   Boolean                    @default(true)
  isDeleted      Boolean                    @default(false)
  image          String?
  shopId         Int
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  shop           Shop                       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category       RestaurantMenuCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subCategory    RestaurantMenuSubCategory? @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  orderItems     RestaurantOrderItem[]

  @@map("restaurant_menu_items")
}

model RestaurantOrder {
  id             Int                   @id @default(autoincrement())
  order_token    String
  table_number   String?
  platform       String?
  taken_by_id    Int?
  taken_by_name  String?
  status         String                @default("pending")
  total_amount   Float
  customer_name  String?
  customer_phone String?
  customer_notes String?
  is_self_order  Boolean               @default(false)
  shopId         Int
  created_at     DateTime              @default(now())
  updated_at     DateTime              @updatedAt
  items          RestaurantOrderItem[]
  shop           Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, order_token])
  @@index([shopId, status])
  @@index([shopId, table_number])
  @@index([shopId, platform])
  @@map("restaurant_orders")
}

model RestaurantOrderItem {
  id           Int                 @id @default(autoincrement())
  orderId      Int
  menu_item_id Int?
  name         String
  quantity     Int
  price        Float
  notes        String?
  created_at   DateTime            @default(now())
  order        RestaurantOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menu_item    RestaurantMenuItem? @relation(fields: [menu_item_id], references: [id], onDelete: SetNull)

  @@map("restaurant_order_items")
}

model RestaurantInvoice {
  id               Int                     @id @default(autoincrement())
  invoice_number   String
  order_token      String?
  table_number     String?
  customer_name    String
  customer_phone   String?
  customer_address String?
  customer_gst     String?
  subtotal         Float
  tax_percentage   Float                   @default(0)
  tax_amount       Float                   @default(0)
  discount         Float                   @default(0)
  total            Float
  rounded_total    Float
  round_off        Float                   @default(0)
  payment_method   String                  @default("Cash")
  payment_status   String                  @default("Unpaid")
  amount_paid      Float                   @default(0)
  balance_due      Float                   @default(0)
  notes            String?
  shopId           Int
  created_at       DateTime                @default(now())
  updated_at       DateTime                @updatedAt
  isDeleted        Boolean                 @default(false)
  items            RestaurantInvoiceItem[]
  shop             Shop                    @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, invoice_number])
  @@index([shopId, created_at])
  @@map("restaurant_invoices")
}

model RestaurantInvoiceItem {
  id             Int               @id @default(autoincrement())
  invoiceId      Int
  item_name      String
  item_code      String?
  unit_name      String?
  unit_symbol    String?
  quantity       Float
  price_per_unit Float
  item_total     Float
  created_at     DateTime          @default(now())
  invoice        RestaurantInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("restaurant_invoice_items")
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  action      String
  description String
  module      String
  status      String   @default("Success")
  ipAddress   String?
  userAgent   String?
  userId      Int
  shopId      Int
  metadata    Json?
  createdAt   DateTime @default(now())
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceNotificationStates ServiceNotificationState[]

  @@map("activity_logs")
}

model ServiceNotificationState {
  id            Int       @id @default(autoincrement())
  shopId        Int
  userId        Int
  activityLogId Int
  readAt        DateTime?
  dismissedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  shop        Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityLog ActivityLog @relation(fields: [activityLogId], references: [id], onDelete: Cascade)

  @@unique([userId, activityLogId])
  @@index([shopId, userId])
  @@map("service_notification_states")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  shopId    Int
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id])

  @@unique([name, shopId])
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String
  shopId    Int
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([name, shopId])
  @@map("departments")
}

model DraftInvoice {
  id                  Int                @id @default(autoincrement())
  invoice_number      String?
  customer_name       String
  customer_phone      String?
  customer_address    String?
  customer_gst        String?
  invoice_date        DateTime           @default(now())
  subtotal            Float
  tax_percentage      Float
  tax_amount          Float
  discount            Float              @default(0)
  discount_type       String             @default("percentage")
  discount_amount     Float              @default(0)
  making_charges      Float              @default(0)
  total               Float
  rounded_total       Float
  round_off           Float              @default(0)
  payment_method      String             @default("Cash")
  payment_status      String             @default("Paid")
  amount_paid         Float              @default(0)
  balance_due         Float              @default(0)
  notes               String?
  shopId              Int
  userId              Int?
  interest_percentage Float              @default(0)
  interest_amount     Float              @default(0)
  emi_months          Int?               @default(0)
  exchange            Boolean            @default(false)
  buyback             Boolean            @default(false)
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt
  draft_items         DraftInvoiceItem[]
  shop                Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user                User?              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("draft_invoices")
}

model DraftInvoiceItem {
  id               Int            @id @default(autoincrement())
  draft_invoice_id Int
  item_id          Int?
  item_name        String
  unit_id          Int
  unit_name        String
  unit_symbol      String
  quantity         Float
  price_per_unit   Float
  item_total       Float
  shopId           Int
  draft_invoice    DraftInvoice   @relation(fields: [draft_invoice_id], references: [id], onDelete: Cascade)
  inventory_item   InventoryItem? @relation(fields: [item_id], references: [id])
  shop             Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  unit             Unit           @relation(fields: [unit_id], references: [id])

  @@map("draft_invoice_items")
}

model Expense {
  id          Int      @id @default(autoincrement())
  shopId      Int
  userId      Int?
  title       String
  description String?
  category    String?
  amount      Float
  expenseDate DateTime @default(now())
  paymentMode String?
  notes       String?
  status      String   @default("Pending")
  approvalStep Int     @default(1)
  rejectionReason String?
  receiptUrl  String?
  receiptName String?
  receiptMime String?
  reviewedById Int?
  reviewedAt  DateTime?
  serviceProjectId Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy  User?    @relation("ExpenseReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  serviceProject ServiceProject? @relation(fields: [serviceProjectId], references: [id], onDelete: SetNull)

  @@map("expenses")
}

model GetStartedRequest {
  id                Int      @id @default(autoincrement())
  fullname          String   @db.VarChar(255)
  email             String   @db.VarChar(255)
  phone             String   @db.VarChar(50)
  business_type     String   @db.VarChar(255)
  business_name     String?  @db.VarChar(255)
  business_location String?  @db.VarChar(255)
  message           String
  source            String   @default("Website")
  created_at        DateTime @default(now())

  @@map("get_started_requests")
}

model PurchaseBill {
  id             Int      @id @default(autoincrement())
  shopId         Int
  billNumber     String?
  billDate       DateTime @default(now())
  supplierName   String
  supplierPhone  String?
  supplierGst    String?
  subtotal       Float?
  taxAmount      Float?
  discountAmount Float    @default(0)
  totalAmount    Float?
  paymentMode    String?
  notes          String?
  billFileUrl    String?
  billFileType   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@map("purchase_bills")
}

model ServiceClient {
  id            Int      @id @default(autoincrement())
  clientId      String
  company       String
  contact       String
  phone         String?
  email         String?
  gst           String?
  billing       String   @default("Monthly")
  contractStart DateTime
  contractEnd   DateTime
  status        String   @default("Active")
  revenue       Float    @default(0)
  shopId        Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  serviceInvoices ServiceInvoice[]

  @@unique([shopId, clientId])
  @@map("service_clients")
}

model ServiceProject {
  id         Int                @id @default(autoincrement())
  projectId  String
  name       String
  description String?
  client     String
  manager    String
  team       Int
  teamMembers Json?
  milestones  Json?
  start      DateTime
  end        DateTime
  budget     Float
  status     String             @default("Active")
  documentation Json?
  shopId     Int
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  shop       Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  tasks      ServiceTask[]
  timesheets ServiceTimesheet[]
  serviceInvoices ServiceInvoice[]
  expenses   Expense[]

  @@unique([shopId, projectId])
  @@map("service_projects")
}

model ServiceInvoice {
  id              Int             @id @default(autoincrement())
  invoiceId        String
  clientId         Int?
  projectId        Int?
  clientName       String?
  projectName      String?
  issuedDate       DateTime        @db.Date
  dueDate          DateTime?       @db.Date
  terms            String?
  notes            String?
  status           String          @default("Draft")
  discountPercent  Float           @default(0)
  subtotal         Float           @default(0)
  taxTotal         Float           @default(0)
  amount           Float           @default(0)
  paid             Float           @default(0)
  items            Json?
  payments         Json?
  shopId           Int
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  client           ServiceClient?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project          ServiceProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  shop             Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, invoiceId])
  @@index([shopId])
  @@map("service_invoices")
}

model ServiceTask {
  id             Int            @id @default(autoincrement())
  taskId         String
  title          String
  description    String?
  assignee       String
  priority       String
  deadline       DateTime
  project        String
  column         String         @default("Pending")
  comments       Int            @default(0)
  attachments    Int            @default(0)
  projectId      Int
  shopId         Int
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  serviceProject ServiceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shop           Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, taskId])
  @@map("service_tasks")
}

model ServiceTimesheet {
  id             Int            @id @default(autoincrement())
  date           DateTime       @db.Date
  project        String
  task           String
  hours          Float
  billable       Boolean        @default(true)
  status         String         @default("Pending")
  projectId      Int
  shopId         Int
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  serviceProject ServiceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shop           Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("service_timesheets")
}

model Asset {
  id             Int       @id @default(autoincrement())
  assetId        String
  name           String
  category       String
  vendor         String?
  serialNumber   String?
  cost           Float?
  purchaseDate   DateTime
  warrantyExpiry DateTime?
  condition      String    @default("New")
  status         String    @default("Available")
  assignedTo     String?
  shopId         Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  shop           Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, assetId])
  @@unique([shopId, serialNumber])
  @@map("assets")
}

model ServiceJournalEntry {
  id          Int                @id @default(autoincrement())
  entryDate   DateTime           @db.Date
  reference   String?
  narration   String
  status      String             @default("Posted")
  shopId      Int
  createdById Int?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  lines       ServiceJournalLine[]
  shop        Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdBy   User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([shopId, entryDate])
  @@map("service_journal_entries")
}

model ServiceJournalLine {
  id          Int                @id @default(autoincrement())
  entryId     Int
  ledger      String
  debit       Float              @default(0)
  credit      Float              @default(0)
  description String?

  entry ServiceJournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@map("service_journal_lines")
}

model ServiceAccountingSheet {
  id          Int      @id @default(autoincrement())
  month       Int
  year        Int
  adjustments Json?    @default("[]") // [{ id, type, amount, description }]
  shopId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, month, year])
  @@map("service_accounting_sheets")
}

model ServiceFiscalPeriod {
  id         Int      @id @default(autoincrement())
  name       String   // e.g. "FY 2025-26"
  startMonth Int
  startYear  Int
  endMonth   Int
  endYear    Int
  shopId     Int
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("service_fiscal_periods")
}

model RolePermission {
  id        Int      @id @default(autoincrement())
  shopId    Int
  role      String   // "Admin" | "Employee"
  module    String   // "PROJECT" | "CLIENTS" | "ASSETS" etc.
  canCreate Boolean  @default(false)
  canRead   Boolean  @default(false)
  canUpdate Boolean  @default(false)
  canDelete Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, role, module])
  @@map("role_permissions")
}

model SupportCallback {
  id                Int      @id @default(autoincrement())
  name              String
  email             String
  phone             String
  preferred_date    String
  preferred_time    String
  issue_description String
  status            String   @default("Pending") // Pending | Called | Resolved
  source            String   @default("Website")
  createdAt         DateTime @default(now())

  @@map("support_callbacks")
}

model SupportTicket {
  id                Int      @id @default(autoincrement())
  ticketId          String   @unique
  email             String
  subject           String
  category          String
  subcategory       String?
  priority          String
  description       String
  status            String   @default("Open") // Open | In-Progress | Closed
  source            String   @default("Website")
  createdAt         DateTime @default(now())

  @@map("support_tickets")
}

